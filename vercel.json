{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/staff/(.*)",
      "destination": "https://api.honjaya-server.xyz/api/staff/$1"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "https://api.honjaya-server.xyz/api/admin/$1"
    }
  ]
}
