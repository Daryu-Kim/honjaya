{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/rest/v1/(.*)",
      "destination": "https://api.honjaya-server.xyz/rest/v1/$1"
    },
    {
      "source": "/api/staff/(.*)",
      "destination": "https://api.honjaya-server.xyz/api/staff/$1"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "https://api.honjaya-server.xyz/api/admin/$1"
    },
    {
      "source": "/api/guest/(.*)",
      "destination": "https://api.honjaya-server.xyz/api/guest/$1"
    },
    {
      "source": "/api/payments",
      "destination": "https://api.honjaya-server.xyz/api/payments"
    },
    {
      "source": "/api/payments/(.*)",
      "destination": "https://api.honjaya-server.xyz/api/payments/$1"
    },
    {
      "source": "/api/points",
      "destination": "https://api.honjaya-server.xyz/api/points"
    },
    {
      "source": "/api/points/(.*)",
      "destination": "https://api.honjaya-server.xyz/api/points/$1"
    },
    {
      "source": "/api/crm",
      "destination": "https://api.honjaya-server.xyz/api/crm"
    },
    {
      "source": "/api/crm/(.*)",
      "destination": "https://api.honjaya-server.xyz/api/crm/$1"
    },
    {
      "source": "/api/kakao/(.*)",
      "destination": "https://api.honjaya-server.xyz/api/kakao/$1"
    }
  ]
}
