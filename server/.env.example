# 서버 실행 설정 (server/.env 로 복사해서 사용)
PORT=3000
HOST=0.0.0.0

# Postgres 접속 정보 (docker-compose 기본값과 동일)
DATABASE_URL=postgres://honjaya:honjaya@127.0.0.1:5432/honjaya
DB_POOL_MAX=10

# 프론트엔드가 보낼 키. 비워두면 인증을 끕니다(로컬 개발 전용).
# Supabase의 anon key 자리에 그대로 넣어 쓰면 프론트 수정이 거의 필요 없습니다.
ANON_KEY=
SERVICE_KEY=

# CORS 허용 오리진 (쉼표 구분, * 는 전체 허용)
CORS_ORIGINS=*

LOG_LEVEL=info
