# 서버 실행 설정 (server/.env 로 복사해서 사용)
PORT=3000
HOST=0.0.0.0

# docker compose 의 db 컨테이너 비밀번호 (compose 가 이 값을 읽어 갑니다).
# 비워두면 postgres 가 기본값으로 쓰입니다. DB 포트는 외부에 열지 않지만 정해두는 편이 안전합니다.
# 한 번 정한 뒤에는 바꾸지 마세요 — pgdata/ 가 이 값으로 초기화됩니다.
POSTGRES_PASSWORD=

# Postgres 접속 정보 (docker-compose 기본값과 동일)
DATABASE_URL=postgres://honjaya:honjaya@127.0.0.1:5432/honjaya
DB_POOL_MAX=10

# 프론트엔드가 보낼 키. 비워두면 인증을 끕니다(로컬 개발 전용).
# Supabase의 anon key 자리에 그대로 넣어 쓰면 프론트 수정이 거의 필요 없습니다.
ANON_KEY=
SERVICE_KEY=

# CORS 허용 오리진 (쉼표 구분, * 는 전체 허용)
# 배포 시에는 실제 프런트엔드 오리진만 넣으세요. 예: https://honjaya.vercel.app
# 로컬 개발(`pnpm run serve`, 8080)까지 함께 쓰려면:
#   CORS_ORIGINS=https://honjaya.vercel.app,http://localhost:8080
CORS_ORIGINS=*

# 직원 로그인(/admin, /tablet) 세션 쿠키 설정
#  - STAFF_SESSION_HOURS: "로그인 유지"를 끈 경우 유지 시간
#  - STAFF_REMEMBER_DAYS: "로그인 유지"를 켠 경우 유지 일수
#  - COOKIE_SECURE: auto(기본, https 요청일 때만 Secure) | true | false
#  - STAFF_COOKIE_DOMAIN: 비워두면 요청 호스트에만 붙는 쿠키가 됩니다(권장).
STAFF_SESSION_HOURS=12
STAFF_REMEMBER_DAYS=30
COOKIE_SECURE=auto
STAFF_COOKIE_DOMAIN=

# 최초 사장 계정 생성 시 사용 (npm run staff:seed)
# 비워두면 무작위 비밀번호를 만들어 한 번만 화면에 출력합니다.
STAFF_OWNER_LOGIN=owner
STAFF_OWNER_NAME=사장
STAFF_OWNER_PASSWORD=

LOG_LEVEL=info

# 마케팅 문자/알림톡 발송(P7). 회원은 휴대폰 번호로만 식별하며 카카오 로그인은 쓰지 않습니다.
#  - MESSAGING_PROVIDER: dryrun(기본, 실제 발송 없음) / none(기능 끔) / solapi
#  - MESSAGING_SENDER: 발신번호(사전 등록 필요) — 검수용 모드에서는 비워도 됩니다
#  - SOLAPI_*: 솔라피 계약 후 발급받은 키 (MESSAGING_PROVIDER=solapi 일 때만 사용)
MESSAGING_PROVIDER=dryrun
MESSAGING_SENDER=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# ── P12. Discord 관리봇 ──────────────────────────────────────────────
# 봇 토큰은 bot 컨테이너에만 들어갑니다(api 컨테이너는 모릅니다).
# 봇 생성: https://discord.com/developers/applications → New Application → Bot
#   1) Bot 탭에서 Privileged Gateway Intents 중 SERVER MEMBERS INTENT 를 반드시 ON
#      (꺼져 있으면 게이트웨이가 4014 로 끊습니다. 1개 서버만 쓰면 심사는 필요 없습니다)
#      MESSAGE CONTENT INTENT 는 쓰지 않으므로 OFF 로 두세요.
#   2) OAuth2 → URL Generator: scopes=bot, applications.commands /
#      permissions=Manage Roles, Manage Channels, Kick Members, Ban Members,
#      Moderate Members, Manage Messages, Manage Threads, Create Invite,
#      Manage Webhooks, View Audit Log, Send Messages, Embed Links, Attach Files
#   3) 봇 역할을 서버 최상단(사장 역할 바로 아래)으로 올리고 Administrator 는 주지 마세요.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# 관리할 서버(길드) ID — Discord 설정 → 고급 → 개발자 모드 후 서버 우클릭 "ID 복사"
DISCORD_GUILD_ID=
# 슬래시 명령·고위험 작업을 허용할 본인 Discord 사용자 ID
DISCORD_OWNER_USER_ID=
# 백업 파일을 올릴 채널 ID / 공지 채널 ID (둘 다 비워도 됩니다)
DISCORD_BACKUP_CHANNEL_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=

# api → bot 내부 통신 토큰. 비워두면 봇이 /api/discord/* 요청을 모두 503 으로 거부합니다.
# openssl rand -hex 32 결과를 넣으세요.
BOT_INTERNAL_TOKEN=
BOT_API_URL=http://bot:4100
BOT_TIMEOUT_MS=15000
BOT_DB_POOL_MAX=4

# 백업(P12B). 이 키를 잃으면 백업을 복호화할 수 없습니다. 오프라인 사본을 꼭 보관하세요.
# openssl rand -base64 32 결과를 넣으세요.
BACKUP_ENCRYPTION_KEY=
DISCORD_MAX_UPLOAD_MB=20
