rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == "admin"
      );
    }

    function isSafeString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isOptionalString(value, maxLen) {
      return !(value is string) || value.size() <= maxLen;
    }

    function isNonNegativeNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    function isOwnerOnCreate() {
      return signedIn() &&
        request.resource.data.uid is string &&
        request.resource.data.uid == request.auth.uid;
    }

    function isOwner() {
      return signedIn() &&
        resource.data.uid is string &&
        resource.data.uid == request.auth.uid;
    }

    // 전체 채팅
    match /chatMessages/{messageId} {
      allow read: if signedIn();

      allow create: if
        (
          isOwnerOnCreate() &&
          request.resource.data.messageType == "USER" &&
          isSafeString(request.resource.data.message, 300) &&
          isSafeString(request.resource.data.nickname, 30) &&
          isSafeString(request.resource.data.tableNumber, 10) &&
          isSafeString(request.resource.data.senderLabel, 100)
        ) ||
        (
          isAdmin() &&
          (
            request.resource.data.messageType == "ADMIN" ||
            request.resource.data.messageType == "SYSTEM"
          ) &&
          isSafeString(request.resource.data.message, 500)
        );

      allow update, delete: if isAdmin();
    }

    // 주문
    match /orders/{orderId} {
      allow read: if isAdmin() || isOwner();

      allow create: if
        isOwnerOnCreate() &&
        isSafeString(request.resource.data.tableNumber, 10) &&
        isSafeString(request.resource.data.nickname, 30) &&
        isOptionalString(request.resource.data.requestMessage, 300) &&
        request.resource.data.status == "REQUESTED" &&
        request.resource.data.totalCount is int &&
        request.resource.data.totalCount > 0 &&
        isNonNegativeNumber(request.resource.data.totalPrice) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0;

      allow update, delete: if isAdmin();
    }

    // 계산 요청
    match /checkoutRequests/{requestId} {
      allow read: if isAdmin() || isOwner();

      allow create: if
        isOwnerOnCreate() &&
        isSafeString(request.resource.data.tableNumber, 10) &&
        isSafeString(request.resource.data.nickname, 30) &&
        request.resource.data.status == "REQUESTED";

      allow update, delete: if isAdmin();
    }

    // 유튜브 신청
    match /youtubeRequests/{requestId} {
      allow read: if isAdmin() || isOwner();

      allow create: if
        isOwnerOnCreate() &&
        request.resource.data.requestType == "YOUTUBE" &&
        isSafeString(request.resource.data.tableNumber, 10) &&
        isSafeString(request.resource.data.nickname, 30) &&
        isSafeString(request.resource.data.youtubeVideoId, 30) &&
        isSafeString(request.resource.data.title, 300) &&
        isSafeString(request.resource.data.youtubeChannelTitle, 200) &&
        isSafeString(request.resource.data.thumbnailUrl, 1000) &&
        request.resource.data.status == "WAITING";

      allow update, delete: if isAdmin();
    }

    // 상품
    match /products/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // 카테고리
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}