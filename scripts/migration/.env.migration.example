# Copy this file to the repo root as `.env.migration` and fill in the values.
# Supabase Dashboard -> Settings -> API
#   SUPABASE_URL: Project URL
#   SUPABASE_SERVICE_ROLE_KEY: service_role secret (script only, never ship to clients)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
