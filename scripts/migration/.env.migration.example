# Copy this file to the repo root as `.env.migration` and fill in the values.
# Firebase (export only) - Firebase console -> Project settings -> Project ID
#   FIREBASE_PROJECT_ID: project id used by export-firestore.mjs
# Supabase (import) - Supabase Dashboard -> Settings -> API
#   SUPABASE_URL: Project URL
#   SUPABASE_SERVICE_ROLE_KEY: service_role secret (script only, never ship to clients)
FIREBASE_PROJECT_ID=your-firebase-project-id
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
